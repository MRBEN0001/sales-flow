# =============================================================================
# Sales Flow — PRODUCTION environment
# =============================================================================
# Deploy: copy/rename this file to .env on your server, then fill in secrets
# marked CHANGE_ME and run:
#
#   composer install --no-dev --optimize-autoloader
#   php artisan key:generate          (only if APP_KEY is empty)
#   php artisan migrate --force
#   php artisan config:cache
#   php artisan route:cache
#   php artisan view:cache
#
# DNS required:
#   salesflow.top          → your server (central: register, login, marketing)
#   *.salesflow.top        → your server (tenant shops: shopname.salesflow.top)
# =============================================================================

APP_NAME="Sales Flow"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://salesflow.top
APP_TIMEZONE=Africa/Lagos

# Central app domain + tenant subdomains (both must match your bought domain)
CENTRAL_DOMAIN=salesflow.top
TENANT_DOMAIN=salesflow.top

# Subscription
SUBSCRIPTION_TRIAL_DAYS=30

LOG_CHANNEL=stack
LOG_LEVEL=error

# Central database (tenants + domains). MySQL user MUST have CREATE DATABASE permission.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=salesflow
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — use your host SMTP or a provider (Mailgun, Brevo, etc.)
MAIL_MAILER=smtp
MAIL_HOST=smtp.your-mail-provider.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@salesflow.top
MAIL_FROM_NAME="${APP_NAME}"

# Paystack LIVE keys
PAYSTACK_PUBLIC_KEY=pk_live_1cdc4e27003719f7b01e5d49fa4d8c9809b887fe
PAYSTACK_SECRET_KEY=sk_live_29ca6ac735874447fd91a658032e5fa1bf5e3d02
PAYSTACK_PAYMENT_URL=https://api.paystack.co

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
